<Window x:Class="TrainingSystem.PC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultralydstræningssystem — feedback efter session" Height="940" Width="1480"
        MinHeight="760" MinWidth="1120" Background="#F4F6F9">
    <Window.Resources>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#65758B" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172B4D" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#65758B" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- Overskrift -->
        <DockPanel LastChildFill="True">
            <TextBlock Text="Ultralydstræningssystem" FontSize="26" FontWeight="SemiBold" Foreground="#172B4D" />
            <TextBlock DockPanel.Dock="Right" Text="FEEDBACK EFTER SESSION · PROTOTYPE"
                       VerticalAlignment="Center" Foreground="#65758B" FontSize="12" Margin="20,0,0,0" />
        </DockPanel>

        <!-- Betjening -->
        <StackPanel Grid.Row="1" Margin="0,14,0,12">
            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="UDP-port:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="PortTextBox" Text="5005" Width="70" Padding="5" Margin="0,0,8,0" />
                <Button x:Name="ListenButton" Content="Start modtagelse" Click="ListenButton_Click" Padding="13,7" Margin="0,0,6,0" />
                <Button x:Name="StopListenButton" Content="Stop modtagelse" Click="StopListenButton_Click" Padding="13,7" IsEnabled="False" Margin="0,0,20,0" />

                <TextBlock Text="Referencerute:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="RouteComboBox" Width="250" Padding="5" Margin="0,0,6,0"
                          SelectionChanged="RouteComboBox_SelectionChanged" />
                <Button x:Name="RefreshRoutesButton" Content="Opdatér" Click="RefreshRoutesButton_Click" Padding="10,7" Margin="0,0,14,0" />

                <TextBlock Text="Korridor (mm):" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="CorridorTextBox" Text="15" Width="56" Padding="5" Margin="0,0,20,0" />

                <Button x:Name="StartSessionButton" Content="Start session" Click="StartSessionButton_Click" Padding="14,7" Margin="0,0,6,0" />
                <Button x:Name="EndSessionButton" Content="Afslut session og analysér" Click="EndSessionButton_Click" Padding="14,7" IsEnabled="False" />
            </WrapPanel>

            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="SaveAsRouteButton" Content="Gem sessionen som referencerute" Click="SaveAsRouteButton_Click" Padding="11,6" Margin="0,0,6,0" IsEnabled="False" />
                <Button x:Name="OpenSessionButton" Content="Åbn gemt session…" Click="OpenSessionButton_Click" Padding="11,6" Margin="0,0,6,0" />
                <Button x:Name="OpenFolderButton" Content="Åbn datamappe" Click="OpenFolderButton_Click" Padding="11,6" Margin="0,0,24,0" />

                <CheckBox x:Name="FilterCheckBox" Content="Filtrér støj" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="Vindue (ms):" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="FilterWindowTextBox" Text="100" Width="52" Padding="5" Margin="0,0,8,0" />
                <ComboBox x:Name="FilterModeComboBox" Width="180" Padding="5" SelectedIndex="0" Margin="0,0,10,0">
                    <ComboBoxItem Content="Centreret (nulfase)" />
                    <ComboBoxItem Content="Kausalt (som live)" />
                </ComboBox>
                <CheckBox x:Name="FilterOrientationCheckBox" Content="Filtrér også orientering" VerticalAlignment="Center" />
            </WrapPanel>
        </StackPanel>

        <!-- Hovedområde -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status: forbindelse og session. Ingen måleværdier. -->
                <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                    <Ellipse x:Name="ConnectionIndicator" Width="11" Height="11" Fill="Gray" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Modtager ikke" FontWeight="SemiBold" Foreground="#172B4D" VerticalAlignment="Center" />
                    <TextBlock x:Name="SessionStatusText" DockPanel.Dock="Right" Text="Ingen aktiv session" Foreground="#65758B" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Venstre: 3D-visning. Tilladt under en session (FR-08). -->
                <StackPanel Grid.Row="1" Margin="0,0,14,0">
                    <TextBlock Text="3D-VISNING AF PROBEN" Style="{StaticResource SectionHeader}" />
                    <Border BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Height="330">
                        <Viewport3D x:Name="ProbeViewport" ClipToBounds="True">
                            <Viewport3D.Camera>
                                <PerspectiveCamera Position="3,3,5" LookDirection="-3,-3,-5" UpDirection="0,1,0" FieldOfView="55" />
                            </Viewport3D.Camera>
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <Model3DGroup>
                                        <AmbientLight Color="#FFFFFF" />
                                        <DirectionalLight Color="#FFFFFF" Direction="-1,-2,-3" />
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                            <ModelVisual3D x:Name="SceneVisual" />
                            <ModelVisual3D x:Name="TrajectoryVisual" />
                            <ModelVisual3D x:Name="ProbeModelVisual" />
                        </Viewport3D>
                    </Border>
                    <TextBlock Text="Probens position, stilling og bevægelse vises løbende. Der vises ingen måleværdier og ingen vurdering, før sessionen er afsluttet (FR-08)."
                               TextWrapping="Wrap" FontSize="11" Foreground="#65758B" Margin="2,7,2,0" />

                    <TextBlock Text="DATAGAB" Style="{StaticResource SectionHeader}" Margin="0,14,0,5" />
                    <Border BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="8" Background="#FDFDFE" Padding="10" MinHeight="70">
                        <TextBlock x:Name="GapsText" Text="—" TextWrapping="Wrap" FontSize="11" Foreground="#344563" />
                    </Border>
                </StackPanel>

                <!-- Højre: skifter mellem tomgang, kørende session og resultat -->
                <Grid Grid.Column="1" Grid.Row="1">

                    <!-- Tomgang -->
                    <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Klar" FontSize="20" FontWeight="SemiBold" Foreground="#172B4D" HorizontalAlignment="Center" />
                        <TextBlock Text="Vælg en referencerute, start modtagelsen og start derefter sessionen."
                                   Foreground="#65758B" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
                    </StackPanel>

                    <!-- Session i gang: ingen måledata, ingen vurdering (FR-08) -->
                    <StackPanel x:Name="RunningPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Sessionen kører" FontSize="24" FontWeight="SemiBold" Foreground="#172B4D" HorizontalAlignment="Center" />
                        <TextBlock Text="Bevægelsen vises i 3D. Resultatet vises, når sessionen afsluttes."
                                   FontSize="14" Foreground="#344563" Margin="0,10,0,0" HorizontalAlignment="Center" />
                        <Border Background="#FFF4D6" BorderBrush="#D6B656" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,22,0,0" MaxWidth="460">
                            <TextBlock TextWrapping="Wrap" Foreground="#5F4B14" FontSize="12"
                                       Text="Probens bevægelse vises i 3D til venstre. Men systemet viser med vilje hverken måleværdier, afvigelse, korridor, graf eller vurdering undervejs: interviewet med CAMES viser, at feedback under udførelsen giver dårligere læring, og FR-08 er skrevet ud fra det fund." />
                        </Border>
                    </StackPanel>

                    <!-- Resultat efter sessionen -->
                    <ScrollViewer x:Name="ResultsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="StatusBanner" Background="#E6F4EA" BorderBrush="#82B366" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="StatusBannerTitle" Text="Gennemført" FontWeight="SemiBold" Foreground="#1E4620" />
                                    <TextBlock x:Name="StatusBannerText" Text="" TextWrapping="Wrap" Foreground="#344563" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="FEEDBACK EFTER SESSIONEN" Style="{StaticResource SectionHeader}" />
                            <UniformGrid Columns="5" Rows="1" Margin="0,0,0,12">
                                <Border Background="#F3F6FB" CornerRadius="8" Padding="9" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Middelafvigelse" Style="{StaticResource CardLabel}" />
                                        <TextBlock x:Name="MeanDeviationValue" Text="—" Style="{StaticResource CardValue}" />
                                        <TextBlock Text="mm" Style="{StaticResource CardLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F3F6FB" CornerRadius="8" Padding="9" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Største afvigelse" Style="{StaticResource CardLabel}" />
                                        <TextBlock x:Name="MaxDeviationValue" Text="—" Style="{StaticResource CardValue}" />
                                        <TextBlock Text="mm" Style="{StaticResource CardLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F3F6FB" CornerRadius="8" Padding="9" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Tid i korridor" Style="{StaticResource CardLabel}" />
                                        <TextBlock x:Name="InCorridorValue" Text="—" Style="{StaticResource CardValue}" />
                                        <TextBlock x:Name="CorridorNote" Text="%" Style="{StaticResource CardLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F3F6FB" CornerRadius="8" Padding="9" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Varighed" Style="{StaticResource CardLabel}" />
                                        <TextBlock x:Name="DurationValue" Text="—" Style="{StaticResource CardValue}" />
                                        <TextBlock Text="sekunder" Style="{StaticResource CardLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F3F6FB" CornerRadius="8" Padding="9">
                                    <StackPanel>
                                        <TextBlock Text="Bevægelsesjævnhed" Style="{StaticResource CardLabel}" />
                                        <TextBlock x:Name="SmoothnessValue" Text="—" Style="{StaticResource CardValue}" />
                                        <TextBlock Text="CV, lavere er jævnere" Style="{StaticResource CardLabel}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="UDFØRT RUTE OG REFERENCERUTE" Style="{StaticResource SectionHeader}" />
                            <Border BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="8" Background="#FDFDFE" Height="260" Margin="0,0,0,12">
                                <Canvas x:Name="RouteCanvas" ClipToBounds="True" SizeChanged="RouteCanvas_SizeChanged" />
                            </Border>

                            <TextBlock Text="AFVIGELSE OVER TID" Style="{StaticResource SectionHeader}" />
                            <Border BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="8" Background="#FDFDFE" Height="180" Margin="0,0,0,12">
                                <Canvas x:Name="DeviationCanvas" ClipToBounds="True" SizeChanged="DeviationCanvas_SizeChanged" />
                            </Border>

                            <TextBlock Text="STØJFILTRERING — FØR OG EFTER" Style="{StaticResource SectionHeader}" />
                            <Border BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="8" Background="#FDFDFE" Height="150" Margin="0,0,0,6">
                                <Canvas x:Name="FilterCanvas" ClipToBounds="True" SizeChanged="FilterCanvas_SizeChanged" />
                            </Border>
                            <TextBlock x:Name="FilterSummaryText" Text="—" TextWrapping="Wrap" FontSize="11" Foreground="#344563" Margin="2,0,2,12" />

                            <TextBlock Text="MÅLINGER I SESSIONEN" Style="{StaticResource SectionHeader}" />
                            <DataGrid x:Name="MeasurementsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="110" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tidsstempel UTC" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="120" />
                                    <DataGridTextColumn Header="Kilde" Binding="{Binding Source}" Width="100" />
                                    <DataGridTextColumn Header="Løbenr." Binding="{Binding SequenceNumber}" Width="70" />
                                    <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat={}{0:F1}}" Width="65" />
                                    <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat={}{0:F1}}" Width="65" />
                                    <DataGridTextColumn Header="Vinkler X/Y/Z" Binding="{Binding Angles}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#65758B" FontSize="11" Margin="0,12,0,0"
                           Text="Feedbacken er beskrivende. Den vurderer ikke teknikken som klinisk god eller dårlig, og prototypen har ingen valideret beståelsesgrænse (W-01)." />
            </Grid>
        </Border>

        <TextBox x:Name="AnalysisTextBox" Grid.Row="3" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True"
                 FontFamily="Consolas" FontSize="11" Padding="10" Background="White" BorderBrush="#DCE2EA"
                 Text="Analysen vises her, når en session er afsluttet." />
    </Grid>
</Window>
